# ==========================================================
# UpMizik - Hostinger Uploads Directory Security
# ==========================================================

# Anpeche ekzekisyon fichye PHP nan dosye uploads la pou sekirite maksimòm
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Pèmèt aksè dirèk ak kouran odyo (Audio Streaming) ak imaj
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000"
</IfModule>
