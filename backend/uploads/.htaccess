# UpMizik - Security Protection for Uploads Directory
# Bloke ekzekisyon tout script PHP, CGI, Python, Shell elatriye

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|sh|exe|bat|cmd)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Enfim PHP engine
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -ExecCGI -Indexes
